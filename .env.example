# Server-side TMDB key used by the refresh job to resolve titles to IMDb IDs.
# Never exposed to clients. Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Vercel Blob read/write token. Auto-injected in Vercel prod/preview; set locally
# only if you want the `blob` storage backend. See:
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Storage backend for catalog data: "blob" (Vercel Blob) or "file" (local disk).
# Defaults to "blob" in Vercel envs and "file" otherwise.
STORAGE_BACKEND=

# Shared secret for /api/refresh. Vercel Cron sets its own auth; this covers
# manual POSTs. Pass as `x-cron-secret` header.
CRON_SECRET=

# Local dev HTTP port for the addon server.
PORT=7500
